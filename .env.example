# Watchlist Server Environment Variables
# Copy this to .env and fill in your values

# JWT Secret - generate a secure random string!
JWT_SECRET=your_super_secret_key_here_change_me

# Server Port
PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://watchlist.satho-net.de

# TMDB API Key (for server-side requests if needed)
TMDB_API_KEY=your_tmdb_api_key_here

# RAWG API Key (for game search)
RAWG_API_KEY=your_rawg_api_key_here
