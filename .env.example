# Watchlist Server Environment Variables
# Copy this to .env and fill in your values

# JWT Secret - generate a secure random string!
JWT_SECRET=your_super_secret_key_here_change_me

# Server Port
PORT=3000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://watchlist.satho-net.de

# TMDB API Key (for server-side requests if needed)
TMDB_API_KEY=your_tmdb_api_key_here

# RAWG API Key (for game search)
RAWG_API_KEY=your_rawg_api_key_here

# Web-Push (optional) – ohne diese Werte erzeugt der Server beim ersten Start
# selbst ein Schlüsselpaar und speichert es in der Datenbank.
# Erzeugen mit: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:du@example.de

# Benutzernamen mit Zugriff aufs Server-Cockpit (kommagetrennt)
DEVELOPER_USERS=
